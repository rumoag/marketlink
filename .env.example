# Copia este archivo como .env y rellena los valores TU MISMO.
# No pegues estas claves en el chat ni las subas a Git.

# Packlink PRO > Configuracion > Clave API
PACKLINK_API_KEY=

# Stripe: clave secreta de PRUEBA (empieza por sk_test_). Nunca una clave real.
STRIPE_SECRET_KEY=

# Version de la API de Stripe. Dejala vacia para usar la de tu cuenta.
# Si Stripe rechaza "bizum" como metodo de pago, prueba con 2026-05-27.dahlia.
STRIPE_API_VERSION=

# Codigos postales y ciudades de prueba para cotizar (origen = artista, destino = comprador)
SPIKE_FROM_ZIP=28001
SPIKE_FROM_CITY=Madrid
SPIKE_TO_ZIP=08001
SPIKE_TO_CITY=Barcelona

# Solo para --register de Packlink: URL https publica donde recibirias webhooks
SPIKE_WEBHOOK_URL=

# Email de contacto para los borradores de prueba de Packlink
SPIKE_EMAIL=

# --- Aplicacion (U1) ---
# sandbox (claves de prueba) o live (claves reales). Ver BR-K2 y BR-K3.
APP_ENV=sandbox
# Nombre provisional del producto (US-051)
PRODUCT_NAME=MarketLink
# URL base publica de la aplicacion
APP_URL=http://localhost:3000
# Cadena de conexion de Postgres (usa el agrupador de conexiones de Supabase)
DATABASE_URL=
# Certificado de la CA de la base (PEM, con 
 escapados) para verificar el TLS. Obligatorio en live.
DATABASE_CA_CERT=
# Solo para pruebas de integracion (Postgres local o de CI)
TEST_DATABASE_URL=
# Secreto del endpoint interno de trabajos (minimo 32 caracteres aleatorios)
INTERNAL_JOBS_SECRET=
# Sal secreta para los resumenes de IP y email del limitador (minimo 32 caracteres aleatorios)
RATE_LIMIT_SALT=
# Nivel de log: debug, info, warn o error
LOG_LEVEL=info

# Secreto de monitorizacion para /api/health/deep (minimo 32 caracteres aleatorios, opcional)
MONITOR_SECRET=

# --- U2: acceso, fotos y cobros ---
# Supabase (Settings > API). La clave de servicio solo vive en el servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secreto para firmar la cookie de actividad de la sesion (minimo 32 caracteres aleatorios)
SESSION_COOKIE_SECRET=
# Stripe: STRIPE_SECRET_KEY ya esta mas arriba (sk_test_ en sandbox, sk_live_ en produccion)
STRIPE_API_VERSION=
STRIPE_CONNECT_WEBHOOK_SECRET=
# SOLO pruebas (CI y local): sustituye Supabase Auth/Storage y Stripe por dobles. Se rechaza en live.

# --- U3: compra y pago ---
# Webhook de la plataforma de Stripe (Developers > Webhooks > endpoint /api/webhooks/stripe)
STRIPE_PLATFORM_WEBHOOK_SECRET=
# Clave de la API de Packlink PRO (solo cotiza en U3). Secreto distinto por entorno
PACKLINK_API_KEY=
# Secreto del que se deriva el token de seguimiento (minimo 32 caracteres). Durante una rotacion,
# el valor anterior pasa a TRACKING_TOKEN_SECRET_PREVIOUS durante 90 dias
TRACKING_TOKEN_SECRET=
TRACKING_TOKEN_SECRET_PREVIOUS=
# Metodos de pago (Bizum pendiente del spike de U0; el manual no se admite en live)
BIZUM_ENABLED=false
PAYMENT_MANUAL_ENABLED=false
# Duraciones de la compra y retencion de datos (valores por defecto entre parentesis)
CHECKOUT_SESSION_MINUTES=30
RESERVATION_MINUTES=32
RETENTION_UNPAID_DAYS=30
RETENTION_PERSONAL_MONTHS=24
RETENTION_FINANCIAL_YEARS=6

# --- U4: envio y correo ---
# Secreto del webhook de Packlink (cabecera X-Packlink-Webhook-Secret). Distinto por entorno
PACKLINK_WEBHOOK_SECRET=
# Resend: clave de solo envio, remitente con dominio verificado y destino de los avisos al operador
RESEND_API_KEY=
EMAIL_FROM=
OPERATOR_EMAIL=
# OBLIGATORIA fuera de live: todos los correos van aqui con asunto [PRUEBA]
EMAIL_SANDBOX_REDIRECT=
RETENTION_LABEL_DAYS=30
RETENTION_LABEL_UNDELIVERED_DAYS=90
RETENTION_NOTIFICATION_MONTHS=12

# --- U5: dinero ---
# manual: la artista pulsa Retirar; automatico: Stripe paga a su banco con su calendario. Obligatoria en live
PAYOUT_MODE=manual
SETTLEMENT_DELAY_HOURS=0
STALE_DELIVERY_DAYS=10
SETTLEMENT_BLOCKED_ALERT_DAYS=7
RECENT_LOGIN_MINUTES=15

# --- U7: transversales ---
# Direccion publica para peticiones de privacidad (puede ser un alias); obligatoria en live
CONTACT_EMAIL=
# Plazo de los datos personales de la compradora (meses desde la entrega)
RETENTION_PERSONAL_MONTHS=12
# Umbrales de alerta por hora (opcionales)
ALERT_AUTH_FAILURES=10
ALERT_AUTHZ_DENIED=10
ALERT_WEBHOOK_SIGNATURES=5

# --- U6: panel del operador (obligatorias en live) ---
# Lista de emails autorizados, separada por comas
OPERATOR_EMAILS=
# email:SECRETO_BASE32 separados por comas (genera cada uno con scripts/ops/new-operator-totp.mjs)
OPERATOR_TOTP_SECRETS=
# 32 caracteres o mas; rotarlo cierra todas las sesiones de operador
OPERATOR_SESSION_SECRET=

E2E_ENABLED=false
